module top (
  clk,
  rst_n,
  raise,
  lower,
  step
)
;
input clk;
input rst_n;
input raise;
input lower;
output [3:0] step;
wire clk_d;
wire rst_n_d;
wire raise_d;
wire lower_d;
wire [3:0] step_d;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  IBUF raise_ibuf (
    .O(raise_d),
    .I(raise) 
);
  IBUF lower_ibuf (
    .O(lower_d),
    .I(lower) 
);
  OBUF step_0_obuf (
    .O(step[0]),
    .I(step_d[0]) 
);
  OBUF step_1_obuf (
    .O(step[1]),
    .I(step_d[1]) 
);
  OBUF step_2_obuf (
    .O(step[2]),
    .I(step_d[2]) 
);
  OBUF step_3_obuf (
    .O(step[3]),
    .I(step_d[3]) 
);
  stepper stepper (
    .clk_d(clk_d),
    .lower_d(lower_d),
    .raise_d(raise_d),
    .rst_n_d(rst_n_d),
    .step_d(step_d[3:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
